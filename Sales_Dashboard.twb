      <aliases enabled='yes' />
      <column caption='YTD Sales' datatype='real' name='[Calculation_191402984799768576]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED: SUM(IF YEAR([Order Date])= {MAX(YEAR([Order Date]))} THEN [Sales] END)}' />
      </column>
      <column caption='YearOnYear Sales' datatype='real' name='[Calculation_191402984801300482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_191402984799768576]-[YTD Sales (copy)_191402984801095681])/[YTD Sales (copy)_191402984801095681]' />
      </column>
      <column caption='YTD Sales Not LOD' datatype='real' name='[Calculation_191402984808980493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date])= {MAX(YEAR([Order Date]))} THEN [Sales] END' />
      </column>
      <column caption='Percentage Diff' datatype='real' name='[Calculation_97601449022570497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_191402984808980493])-SUM([YTD Sales Not LOD (copy)_97601449022316544]))/SUM([YTD Sales Not LOD (copy)_97601449022316544])' />
      </column>
      <column caption='Sales Margin' datatype='string' name='[Calculation_97601449023401986]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_191402984808980493])-SUM([YTD Sales Not LOD (copy)_97601449022316544])&lt;0 THEN &apos;Less than PY&apos;&#10;ELSEIF SUM([Calculation_191402984808980493])-SUM([YTD Sales Not LOD (copy)_97601449022316544])&gt;0 THEN &apos;Greater than PY&apos;&#10;ELSEIF ISNULL(SUM([YTD Sales Not LOD (copy)_97601449022316544])) THEN &apos;No Sales in PY&apos;&#10;END' />
      </column>
